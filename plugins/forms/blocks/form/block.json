{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "forms/form",
	"title": "Form",
	"category": "widgets",
	"icon": "feedback",
	"description": "A contact form of Forms. Fields, e-mail and spam protection: Noxpress → Forms.",
	"keywords": [ "form", "contact", "φόρμα", "επικοινωνία", "email" ],
	"textdomain": "forms",
	"attributes": {
		"formId": { "type": "number", "default": 0 }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "file:./index.js"
}
