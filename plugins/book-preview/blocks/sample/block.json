{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "book-preview/sample",
	"version": "1.0.0",
	"title": "Δείγμα βιβλίου",
	"category": "woocommerce",
	"icon": "book-alt",
	"description": "Το κουμπί «Διαβάστε ένα δείγμα» ενός προϊόντος με δείγμα από το Book Preview.",
	"keywords": [
		"sample",
		"preview",
		"pdf",
		"δείγμα"
	],
	"textdomain": "book-preview",
	"attributes": {
		"productId": {
			"type": "integer",
			"default": 0
		},
		"label": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"usesContext": [
		"postId"
	],
	"editorScript": "file:./index.js"
}
